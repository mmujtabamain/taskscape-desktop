# Comprehensive .gitignore for Rust projects (cross-platform)
#
# Keep Cargo.lock tracked for applications to ensure reproducible builds.
# If this is a library crate and you prefer not to check in Cargo.lock,
# uncomment the line below:
# /Cargo.lock

# Cargo / Rust build outputs
/target/
# Incremental compilation cache (inside target by default)
/target/**/incremental/

# Generated by rustc / cargo
**/*.rmeta
**/*.rlib

# Build artifacts (object files, libs, executables)
*.o
*.obj
*.so
*.dylib
*.dll
*.exe
*.out
*.a
*.lib

# WASM / wasm-pack output
/pkg/
*.wasm

# Documentation
/target/doc/
docs/_build/
docs/build/

# Coverage and profiling outputs
coverage/
*.profraw
*.profdata
*.gcda
*.gcno

# Editor directories and files
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

.idea/
*.iml
*.ipr
*.iws

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.Spotlight-V100
.Trashes
.fseventsd

# Editor swap / backup files
*~
.#*
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Temporary files and logs
*.tmp
*.temp
*.bak
*.orig
*.log
logs/

# Node / frontend artifacts (optional)
node_modules/
dist/
build/

# Local environment files
.env
.env.local
.env.*.local

# Misc
Icon?
*.stackdump